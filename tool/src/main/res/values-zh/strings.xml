<resources>
    <string name="help_action">[帮助]</string>
    <string name="help_title">使用帮助</string>
    <string name="guide_tagline">每天，做一点小事。</string>
    <string name="guide_training_title">力量训练 · 习惯 +</string>
    <string name="guide_training_body">[+] 完成了一次训练。</string>
    <string name="guide_alcohol_title">不喝酒 · 习惯 ±</string>
    <string name="guide_alcohol_body">[+] 今天没有喝酒。\n[−] 喝了酒。</string>
    <string name="guide_food_title">晚上八点后不进食 · 习惯 ±</string>
    <string name="guide_food_body">[+] 做到了。\n[−] 八点后吃了东西。</string>
    <string name="guide_daily_hint">按天判断的目标，建议当天结束后记录。</string>
    <string name="guide_reward_intro">正向记录获得金币，奖励由你设定。</string>
    <string name="guide_add_title">只想记录要减少的行为？</string>
    <string name="guide_add_body">选择“习惯 −”，用行为命名，例如“喝酒”。只有行为发生时，才点 [−]。</string>
    <string name="guide_record_title">按天记录目标</string>
    <string name="guide_record_body">像“不喝酒”这样的目标，建议当天结束后记录一次：做到目标点 [+]；想减少的行为发生了点 [−]。Routine 不会自动标记每天的结果。</string>
    <string name="guide_reward_title">金币与奖励</string>
    <string name="guide_reward_body">简单／中等／困难获得 5／10／20 金币。负向记录最多扣 10。奖励由你设定，也可以不用。</string>
    <string name="guide_privacy">记录保存在本机。无需账号，没有追踪。</string>
    <string name="guide_skip_action">[跳过]</string>
    <string name="guide_start_action">[添加习惯]</string>
    <string name="guide_counts_title">列表与次数</string>
    <string name="guide_counts_body">分类旁的数字是项目数量。习惯旁的数字是所选周、月或年的记录次数。◆ 是可用金币。“习惯 ±”同时提供两种记录按钮。</string>
    <string name="guide_details_title">待办与奖励</string>
    <string name="guide_details_body">待办完成一次获得 10 金币。金币没有货币价值。兑换后点“撤销”，可退回一次费用；历史会保留记录。</string>
    <string name="guide_data_title">你的数据</string>
    <string name="guide_data_body">Routine 可以离线使用。“数据”可在本机生成 CSV 报表和 JSON 备份。下载或上传需要兼容的 LightOS 文件管理器。LightOS 582 不显示 Routine 文件夹。</string>
    <string name="type_positive_help">[+] 表示完成行动，例如“力量训练”。</string>
    <string name="type_negative_help">[−] 表示想减少的行为发生了，例如“喝酒”。</string>
    <string name="type_both_help">[+] 表示做到目标；[−] 表示想减少的行为发生了。</string>
    <string name="type_todo_help">完成一次，获得 10 金币。</string>
