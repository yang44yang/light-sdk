    <string name="help_action">[Help]</string>
    <string name="help_title">Help</string>
    <string name="guide_tagline">Small steps, every day.</string>
    <string name="guide_training_title">Strength training · Habit +</string>
    <string name="guide_training_body">[+] Completed a session.</string>
    <string name="guide_alcohol_title">No alcohol · Habit ±</string>
    <string name="guide_alcohol_body">[+] No alcohol today.\n[−] Drank alcohol.</string>
    <string name="guide_food_title">No food after 8pm · Habit ±</string>
    <string name="guide_food_body">[+] Kept the rule.\n[−] Ate after 8pm.</string>
    <string name="guide_daily_hint">For daily goals, record at the end of the day.</string>
    <string name="guide_reward_intro">Earn gold with [+]; choose your own rewards.</string>
    <string name="guide_add_title">Only tracking what to reduce?</string>
    <string name="guide_add_body">Choose Habit − and name the action, e.g. Drinking alcohol. Tap [−] only when it happens.</string>
    <string name="guide_record_title">Recording daily goals</string>
    <string name="guide_record_body">For goals like No alcohol, record once at the end of the day: [+] if you kept the goal, [−] if the unwanted action happened. Routine does not mark days automatically.</string>
    <string name="guide_reward_title">Gold &amp; rewards</string>
    <string name="guide_reward_body">Easy / Medium / Hard earn 5 / 10 / 20 gold. Negative records use up to 10. Rewards are optional and set by you.</string>
    <string name="guide_privacy">Records stay on this phone. No account or tracking.</string>
    <string name="guide_skip_action">[Skip]</string>
    <string name="guide_start_action">[Add a habit]</string>
    <string name="guide_counts_title">Lists &amp; counts</string>
    <string name="guide_counts_body">Tab numbers count items. Row numbers count records for the selected week, month or year. ◆ is your available gold. Habit ± offers both record buttons.</string>
    <string name="guide_details_title">To-dos &amp; rewards</string>
    <string name="guide_details_body">Completing a to-do earns 10 gold once. Gold has no monetary value. After redeeming a reward, Undo returns its cost once; History keeps the record.</string>
    <string name="guide_data_title">Your data</string>
    <string name="guide_data_body">Routine works offline. Data creates local CSV reports and JSON backups. Downloading or uploading files needs a compatible LightOS File Manager. LightOS 582 does not expose Routine folders.</string>
    <string name="type_positive_help">[+] = completed an action. Example: Strength training.</string>
    <string name="type_negative_help">[−] = the action you want to reduce happened. Example: Drinking alcohol.</string>
    <string name="type_both_help">[+] = kept your goal. [−] = the unwanted action happened.</string>
    <string name="type_todo_help">Complete once to earn 10 gold.</string>
